<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#07111F"
    android:gravity="center_horizontal">

    <!-- Header -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:background="@drawable/gradient_blue_black"
        android:padding="10dp">

        <ImageView
            android:id="@+id/back_btn"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_centerVertical="true"
            android:layout_alignParentStart="true"
            android:src="@drawable/back_arrow_icon"
            android:padding="4dp"/>

        <TextView
            android:id="@+id/channel_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:textStyle="bold"/>
    </RelativeLayout>

    <!-- Status -->
    <TextView
        android:id="@+id/status_tv"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Bağlanıyor..."
        android:textColor="#4CAF50"
        android:textSize="14sp"
        android:layout_marginTop="24dp"
        android:layout_marginBottom="16dp"/>

    <!-- Participants -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Kanaldaki Kullanıcılar"
        android:textColor="#9E9E9E"
        android:textSize="12sp"
        android:layout_marginBottom="8dp"/>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/participants_rv"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:padding="16dp"/>

    <!-- Controls -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="80dp"
        android:orientation="horizontal"
        android:gravity="center"
        android:background="#0D1B2A"
        android:padding="16dp">

        <ImageView
            android:id="@+id/mute_btn"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:src="@android:drawable/ic_btn_speak_now"
            android:background="@drawable/rectangle_top_curved"
            android:padding="10dp"
            android:layout_marginEnd="32dp"/>

        <!-- End call (leave channel) is via back button -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="← Geri basarak kanaldan çıkabilirsiniz"
            android:textColor="#9E9E9E"
            android:textSize="11sp"/>
    </LinearLayout>
</LinearLayout>
